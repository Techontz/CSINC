# Laravel backend origin (no /api/v1). Production: https://api.agizastore.xyz
NEXT_PUBLIC_API_URL=http://127.0.0.1:8291
# Public URL of this website (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3091
# Shared secret; must match FRONTEND_REVALIDATE_SECRET in the Laravel .env.
REVALIDATE_SECRET=change-me
# Development only: allow next/image to optimise images served from localhost.
NEXT_IMAGE_ALLOW_LOCAL_IP=false
